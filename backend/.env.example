# Copy this file to .env for local development (not committed to git).
# In production (Render, etc.), set these as real environment variables
# in the hosting platform's dashboard instead.

# Set to "true" only for local debugging - NEVER in production
FLASK_DEBUG=false

# Comma-separated list of frontend origins allowed to call this API.
# Example: https://anvara-health.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*

# Port the server listens on (most free hosts set this automatically)
PORT=8000
